rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsWorkspace(workspaceId) {
      return signedIn() && workspaceId == 'personal-' + request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update: if ownsUser(uid);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read, create, update: if ownsWorkspace(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if ownsWorkspace(workspaceId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
