{
  "name": "tiendidau",
  "version": "1.0.0",
  "private": true,
  "description": "Tiền Đi Đâu - Ứng dụng quản lý thu chi cá nhân",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
