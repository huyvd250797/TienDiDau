{
  "name": "tiendidau",
  "version": "1.1.3",
  "private": true,
  "description": "Tiền Đi Đâu - Ứng dụng quản lý thu chi cá nhân",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn typecheck && yarn lint && yarn test && yarn format:check"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.16.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "4.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "@firebase/webchannel-wrapper": "1.0.6"
  }
}
